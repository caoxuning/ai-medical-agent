from transformers import GPT2LMHeadModel, BertTokenizerFast
import torch
import os
from config import ParamConfig

params = ParamConfig()

# 加载已经训练好的模型
model = GPT2LMHeadModel.from_pretrained('save_model/model2')
# 将模型加载到设备中CPU or GPU
model = model.to(params.device)
model.eval() # 模型评估模式
# 加载分词器
tokenizer = BertTokenizerFast('data/vocab/vocab.txt',
                              sep_token="[SEP]",
                              pad_token="[PAD]",
                              cls_token="[CLS]"
                              )
os.environ["CUDA_VISIBLE_DEVICES"] = "0"

def main():
    # 开始进行对话
    while True:
        # 输入对话
        text = input('请输入对话：')
        if text == 'exit':
            break
        # 对输入的对话进行分词
        text_ids = tokenizer.encode(text, add_special_tokens=False)
        input_ids = [tokenizer.cls_token_id] + text_ids + [tokenizer.sep_token_id]
        # 将输入的对话转换为张量
        input_ids = torch.tensor(input_ids).unsqueeze(0).to(params.device) # unsqueeze(0)增加batch维度
        # 生成回答
        response = []
        for _ in range(params.max_length):
            # 生成回答
            outputs = model(input_ids=input_ids)
            # 获取模型的预测结果
            next_token_logits = outputs.logits[0, -1, :] # 取出最后一个token的预测结果
            # 对预测结果进行softmax，得到概率分布
            next_token_probs = torch.softmax(next_token_logits, dim=-1)
            # 从概率分布中采样一个token
            next_token_id = torch.multinomial(next_token_probs, num_samples=1)
            # 如果采样的token是[SEP]，则结束生成
            if next_token_id.item() == tokenizer.sep_token_id:
                break
            # 将采样的token添加到回答中
            response.append(next_token_id.item())
            # 将采样的token添加到输入中
            input_ids = torch.cat([input_ids, next_token_id.unsqueeze(0)], dim=-1)

        # 将回答转换为文本
        response = tokenizer.convert_ids_to_tokens(response)
        print('回答：', ''.join(response))

if __name__ == '__main__':
    main()